cat("Rows after cleaning:", nrow(data), "\n")
cat("Columns:", ncol(data), "\n")
data <- read.csv(
"/Users/justincabrera/Documents/Statistical Learning/Datasets/Regression/parkinsons_updrs.data",
na.strings = "?"
)
# Remove rows with missing values
data <- data[complete.cases(data), ]
cat("Rows after cleaning:", nrow(data), "\n")
cat("Columns:", ncol(data), "\n")
set.seed(123)
n <- nrow(data)
train_idx <- sample(seq_len(n), size = floor(0.8 * n))
train_data <- data[train_idx, ]
test_data  <- data[-train_idx, ]
cat("Training examples:", nrow(train_data), "\n")
cat("Testing examples:", nrow(test_data), "\n")
library(randomForest)
# Number of input features: all columns except motor_UPDRS and total_UPDRS
p <- ncol(train_data) - 2  # subtract the two output columns
set.seed(123)
bag_model <- randomForest(
motor_UPDRS ~ . - total_UPDRS,
data       = train_data,
mtry       = p,
ntree      = 500,
importance = TRUE
)
bag_pred <- predict(bag_model, newdata = test_data)
mse_bag  <- mean((test_data$motor_UPDRS - bag_pred)^2)
rmse_bag <- sqrt(mse_bag)
cat("Bagging Test MSE: ", round(mse_bag,  4), "\n")
cat("Bagging Test RMSE:", round(rmse_bag, 4), "\n")
set.seed(123)
rf_model <- randomForest(
motor_UPDRS ~ . - total_UPDRS,
data       = train_data,
mtry       = floor(sqrt(p)),
ntree      = 500,
importance = TRUE
)
rf_pred <- predict(rf_model, newdata = test_data)
mse_rf  <- mean((test_data$motor_UPDRS - rf_pred)^2)
rmse_rf <- sqrt(mse_rf)
cat("Random Forest Test MSE: ", round(mse_rf,  4), "\n")
cat("Random Forest Test RMSE:", round(rmse_rf, 4), "\n")
